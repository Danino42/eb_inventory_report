# Copy this file to .env and adjust. .env is not committed to git.
ENVIRONMENT=development

# JSON list of frontend addresses allowed to call the API
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]

# MongoDB (e.g. a free MongoDB Atlas cluster). Leave empty to keep everything in backend/data/*.json
# and backend/outbox/. Atlas: Connect -> Drivers -> copy the mongodb+srv://... string (with the password)
MONGODB_URI=
MONGODB_DB=eb_inventory

# Inventory reports: first recipients (JSON list). Once Verwaltung -> Einstellungen is saved,
# the addresses from there are used
REPORT_RECIPIENTS=["office@example.com"]

# Sending via Brevo's email API (works where SMTP ports are blocked, e.g. Render's free plan).
# SMTP_FROM below must then be a sender address verified in Brevo
BREVO_API_KEY=

# Or SMTP. Leave BREVO_API_KEY and SMTP_HOST empty to only save emails to backend/outbox/.
# Gmail: smtp.gmail.com, port 587, your address as user and an "app password" (not your normal password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Earlybird Warenbestand <noreply@earlybird.local>
